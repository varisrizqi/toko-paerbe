<resources>
    <!-- Base application theme. -->
    <style name="Base.Theme.Tokopaerbe" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Customize your light theme here. -->
        <!-- <item name="colorPrimary">@color/my_light_primary</item> -->
        <item name="android:windowBackground">@color/white</item>
        <item name="colorSurface">@color/white</item>
        <item name="android:windowTranslucentStatus">false</item>
        <item name="android:statusBarColor">@color/white</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="elevationOverlayEnabled">false</item>

        <item name="android:includeFontPadding">false</item>
        <item name="android:windowSoftInputMode">adjustResize|stateVisible</item>

        <item name="bottomNavigationStyle">@style/Widget.App.BottomNavigationView</item>
    </style>

    <style name="Theme.Tokopaerbe" parent="Base.Theme.Tokopaerbe" />

    <!-- image lingkar. -->
    <style name="ShapeAppearanceOverlay.App.CorneSize50Percent" parent="">
        <item name="cornerSize">50%</item>
    </style>

    <style name="customRoundedImageView8dp" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">8dp</item>
    </style>

    <!-- chip group. -->
    <style name="ThemeOverlay.App.Chip" parent="">
        <item name="elevation">0dp</item>
        <item name="elevationOverlayEnabled">false</item>
    </style>

    <style name="Widget.App.Chip" parent="Widget.Material3.Chip.Suggestion">
        <item name="materialThemeOverlay">@style/ThemeOverlay.App.Chip</item>
        <!--        <item name="android:elevation">0dp</item>-->
        <!--        <item name="elevationOverlayEnabled">false</item>-->
    </style>

    <!-- Bottom Nav. -->
    <style name="Widget.App.BottomNavigationView" parent="Widget.Material3.BottomNavigationView">
        <item name="materialThemeOverlay">@style/ThemeOverlay.App.BottomNavigationView</item>
    </style>
    <style name="ThemeOverlay.App.BottomNavigationView" parent="">
        <item name="fontFamily">@font/poppins_600</item>
    </style>
</resources>