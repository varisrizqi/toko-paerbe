<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.bottomnav.status.StatusFragment">


    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/parent_toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?android:attr/windowBackground"
        android:fitsSystemWindows="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:title="@string/status"
            app:titleCentered="true">

        </com.google.android.material.appbar.MaterialToolbar>

        <com.google.android.material.divider.MaterialDivider
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
    </com.google.android.material.appbar.AppBarLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/parent_toolbar">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/img_status_profile"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_marginTop="32dp"
                android:background="?attr/colorPrimaryContainer"
                android:scaleType="center"
                android:elevation="3dp"
                android:src="@drawable/ic_check"
                app:layout_constraintEnd_toEndOf="@id/cv_status"
                app:layout_constraintStart_toStartOf="@id/cv_status"
                app:layout_constraintTop_toTopOf="parent"
                app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.App.CorneSize50Percent" />

            <androidx.cardview.widget.CardView
                android:id="@+id/cv_status"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="64dp"
                android:elevation="0dp"
                app:cardCornerRadius="8dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <TextView
                        android:id="@+id/tv_payment_success"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="16dp"
                        android:layout_marginTop="48dp"
                        android:fontFamily="@font/poppins_bold"
                        android:gravity="center"
                        android:text="@string/payment_success"
                        android:textColor="@color/primary"
                        android:textSize="20sp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <RatingBar
                        android:id="@+id/rtb_status"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:stepSize="1"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/tv_payment_success" />

                    <TextView
                        android:id="@+id/tv_status_leave_review"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:fontFamily="@font/poppins_600"
                        android:text="@string/leave_a_review"
                        app:layout_constraintEnd_toEndOf="@id/tv_payment_success"
                        app:layout_constraintStart_toStartOf="@id/tv_payment_success"
                        app:layout_constraintTop_toBottomOf="@id/rtb_status" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/input_text"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="0dp"
                        android:layout_height="100dp"
                        android:layout_marginTop="16dp"
                        android:layout_marginBottom="16dp"
                        android:elevation="5dp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="@id/tv_payment_success"
                        app:layout_constraintStart_toStartOf="@id/tv_payment_success"
                        app:layout_constraintTop_toBottomOf="@id/tv_status_leave_review">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/ed_text"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:fontFamily="@font/poppins_400"
                            android:gravity="top|start"
                            android:inputType="textMultiLine"
                            android:maxLines="5"
                            android:scrollbars="vertical"
                            android:scrollHorizontally="false"
                            android:textSize="12sp"
                            tools:text="@string/lorem" />


                    </com.google.android.material.textfield.TextInputLayout>

                </androidx.constraintlayout.widget.ConstraintLayout>
            </androidx.cardview.widget.CardView>

            <TextView
                android:id="@+id/tv_transaction_detail"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:fontFamily="@font/poppins_600"
                android:text="@string/transaction_detail"
                app:layout_constraintEnd_toEndOf="@id/cv_status"
                app:layout_constraintStart_toStartOf="@id/cv_status"
                app:layout_constraintTop_toBottomOf="@+id/cv_status" />

            <com.google.android.material.divider.MaterialDivider
                android:id="@+id/dvdr_center"
                android:layout_width="1dp"
                android:layout_height="1dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/tv_transaction_id"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins"
                android:text="@string/transaction_id"
                android:textSize="12sp"
                app:layout_constraintEnd_toEndOf="@id/dvdr_center"
                app:layout_constraintStart_toStartOf="@id/tv_transaction_detail"
                app:layout_constraintTop_toTopOf="@id/tv_transaction_id_value" />

            <TextView
                android:id="@+id/tv_transaction_id_value"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:fontFamily="@font/poppins_bold"
                android:gravity="end"
                android:textSize="12sp"
                app:layout_constraintEnd_toEndOf="@id/tv_transaction_detail"
                app:layout_constraintStart_toStartOf="@id/dvdr_center"
                app:layout_constraintTop_toBottomOf="@id/tv_transaction_detail"
                tools:text="abcd-efgh-ijkl-mnop" />

            <TextView
                android:id="@+id/tv_status_id"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins"
                android:text="@string/status"
                android:textSize="12sp"
                app:layout_constraintEnd_toEndOf="@id/dvdr_center"
                app:layout_constraintStart_toStartOf="@id/tv_transaction_detail"
                app:layout_constraintTop_toTopOf="@id/tv_status_id_value" />

            <TextView
                android:id="@+id/tv_status_id_value"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="@font/poppins_bold"
                android:gravity="end"
                android:textSize="12sp"
                app:layout_constraintEnd_toEndOf="@id/tv_transaction_detail"
                app:layout_constraintStart_toStartOf="@id/dvdr_center"
                app:layout_constraintTop_toBottomOf="@id/tv_transaction_id_value"
                tools:text="Berhasil" />

            <TextView
                android:id="@+id/tv_date_id"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins"
                android:text="@string/date"
                android:textSize="12sp"
                app:layout_constraintEnd_toEndOf="@id/dvdr_center"
                app:layout_constraintStart_toStartOf="@id/tv_transaction_detail"
                app:layout_constraintTop_toTopOf="@id/tv_date_id_value" />

            <TextView
                android:id="@+id/tv_date_id_value"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="@font/poppins_bold"
                android:gravity="end"
                android:textSize="12sp"
                app:layout_constraintEnd_toEndOf="@id/tv_transaction_detail"
                app:layout_constraintStart_toStartOf="@id/dvdr_center"
                app:layout_constraintTop_toBottomOf="@id/tv_status_id_value"
                tools:text="3 Jun 2024" />

            <TextView
                android:id="@+id/tv_time_id"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins"
                android:text="@string/time"
                android:textSize="12sp"
                app:layout_constraintEnd_toEndOf="@id/dvdr_center"
                app:layout_constraintStart_toStartOf="@id/tv_transaction_detail"
                app:layout_constraintTop_toTopOf="@id/tv_time_id_value" />

            <TextView
                android:id="@+id/tv_time_id_value"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="@font/poppins_bold"
                android:gravity="end"
                android:textSize="12sp"
                app:layout_constraintEnd_toEndOf="@id/tv_transaction_detail"
                app:layout_constraintStart_toStartOf="@id/dvdr_center"
                app:layout_constraintTop_toBottomOf="@id/tv_date_id_value"
                tools:text="22:00" />

            <TextView
                android:id="@+id/tv_payment_method_id"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins"
                android:text="@string/payment_method"
                android:textSize="12sp"
                app:layout_constraintEnd_toEndOf="@id/dvdr_center"
                app:layout_constraintStart_toStartOf="@id/tv_transaction_detail"
                app:layout_constraintTop_toTopOf="@id/tv_payment_method_id_value" />

            <TextView
                android:id="@+id/tv_payment_method_id_value"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="@font/poppins_bold"
                android:gravity="end"
                android:textSize="12sp"
                app:layout_constraintEnd_toEndOf="@id/tv_transaction_detail"
                app:layout_constraintStart_toStartOf="@id/dvdr_center"
                app:layout_constraintTop_toBottomOf="@id/tv_time_id_value"
                tools:text="BCA Virtual Account" />

            <TextView
                android:id="@+id/tv_total_payment_id"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins"
                android:text="@string/total_payment"
                android:textSize="12sp"
                app:layout_constraintEnd_toEndOf="@id/dvdr_center"
                app:layout_constraintStart_toStartOf="@id/tv_transaction_detail"
                app:layout_constraintTop_toTopOf="@id/tv_total_payment_id_value" />

            <TextView
                android:id="@+id/tv_total_payment_id_value"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="@font/poppins_bold"
                android:gravity="end"
                android:textSize="12sp"
                app:layout_constraintEnd_toEndOf="@id/tv_transaction_detail"
                app:layout_constraintStart_toStartOf="@id/dvdr_center"
                app:layout_constraintTop_toBottomOf="@id/tv_payment_method_id_value"
                tools:text="RP.23.499.000" />

            <Button
                android:id="@+id/btn_done"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:layout_marginBottom="16dp"
                android:text="@string/done"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="@id/tv_transaction_detail"
                app:layout_constraintStart_toStartOf="@id/tv_transaction_detail"
                app:layout_constraintTop_toBottomOf="@id/tv_total_payment_id_value"
                app:layout_constraintVertical_bias="1" />

            <com.google.android.material.divider.MaterialDivider
                android:id="@+id/dvdr_bottom"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginBottom="16dp"
                app:layout_constraintBottom_toTopOf="@id/btn_done"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent" />

            <ProgressBar
                android:id="@+id/pg_bar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:visibility="invisible"
                app:layout_constraintStart_toStartOf="@id/btn_done"
                app:layout_constraintEnd_toEndOf="@id/btn_done"
                app:layout_constraintTop_toTopOf="@id/btn_done"
                app:layout_constraintBottom_toBottomOf="@id/btn_done"/>

        </androidx.constraintlayout.widget.ConstraintLayout>


    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>