<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="20dp">

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/iv_item_chart_img_product"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:layout_marginVertical="8dp"
        android:layout_marginStart="12dp"
        android:importantForAccessibility="no"
        android:src="@drawable/thumbnail_load_product"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:shapeAppearanceOverlay="@style/customRoundedImageView8dp" />

    <TextView
        android:id="@+id/tv_item_chart_product_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:fontFamily="@font/poppins_medium"
        android:lines="1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/iv_item_chart_img_product"
        app:layout_constraintTop_toTopOf="@id/iv_item_chart_img_product"
        tools:text="Lenovo Legion 7 16 I7 11800 16GB 1TB SSD RTX3070 8GB" />

    <TextView
        android:id="@+id/tv_item_chart_variant"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:fontFamily="@font/poppins_400"
        android:textSize="10sp"
        app:layout_constraintStart_toStartOf="@id/tv_item_chart_product_name"
        app:layout_constraintTop_toBottomOf="@id/tv_item_chart_product_name"
        tools:text="16GB, 1 TB" />

    <TextView
        android:id="@+id/tv_item_chart_stock"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:fontFamily="@font/poppins_400"
        android:textSize="10sp"
        app:layout_constraintStart_toStartOf="@id/tv_item_chart_variant"
        app:layout_constraintTop_toBottomOf="@id/tv_item_chart_variant"
        tools:text="@string/_5_left" />

    <TextView
        android:id="@+id/tv_item_chart_price"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="8dp"
        android:fontFamily="@font/poppins_medium"
        app:layout_constraintBottom_toBottomOf="@id/iv_item_chart_img_product"
        app:layout_constraintEnd_toStartOf="@id/tv_stock"
        app:layout_constraintStart_toStartOf="@id/tv_item_chart_variant"
        tools:text="Rp23.499.0000" />

    <TextView
        android:id="@+id/tv_stock"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="30dp"
        android:fontFamily="@font/poppins_medium"
        android:text="@string/_1x"
        android:textSize="12sp"
        app:layout_constraintBottom_toBottomOf="@id/tv_item_chart_price"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/tv_item_chart_price"
        app:layout_constraintTop_toTopOf="@id/tv_item_chart_price" />
</androidx.constraintlayout.widget.ConstraintLayout>